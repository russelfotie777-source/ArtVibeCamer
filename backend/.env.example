APP_NAME=ArtVibeCamer
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_TIMEZONE=Africa/Douala
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug


DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=artvibecamer
DB_USERNAME=
DB_PASSWORD=
# XAMPP/LAMPP expose MariaDB sur ce socket et non sur /run/mysqld/mysqld.sock
DB_SOCKET=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- ArtVibeCamer ---
FRONTEND_URL=http://localhost:3000

# Passerelle de paiement : fake | campay | cinetpay
PAYMENT_DRIVER=fake
PAYMENT_CURRENCY=XAF
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_APP_USERNAME=
CAMPAY_APP_PASSWORD=
CAMPAY_WEBHOOK_KEY=
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com
CINETPAY_SITE_ID=
CINETPAY_API_KEY=
CINETPAY_SECRET_KEY=

# Signature des QR codes de tickets
TICKET_QR_SECRET=
