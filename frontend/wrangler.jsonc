{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "artvibecamer",
  "main": ".open-next/worker.js",

  // nodejs_compat est requis par l'adaptateur : Next.js s'appuie sur des
  // modules Node que le runtime Workers ne fournit pas par defaut.
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "observability": {
    "enabled": true
  }
}
