# Delais d'attente etendus : sur une connexion instable, l'installation par
# defaut abandonne a mi-parcours et laisse des fichiers tronques dans
# node_modules, ce qui se manifeste plus tard par des erreurs de typage
# incomprehensibles dans des dependances.
fetch-timeout=900000
fetch-retries=8
fetch-retry-maxtimeout=120000
audit=false
fund=false

# Connexion instable : moins de sockets simultanees evite les timeouts
maxsockets=3
